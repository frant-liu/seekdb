# Preserve complete IK token output across character categories.
--disable_query_log
set names utf8mb4;
select tokenize(convert(X'' using utf8mb4),'ik') as case_00;
select tokenize(convert(X'415a617a30313939' using utf8mb4),'ik') as case_01;
select tokenize(convert(X'4142432078797a2031322e333420323032362d31302d3239' using utf8mb4),'ik') as case_02;
select tokenize(convert(X'efbca1efbca2efbca3efbd81efbd82efbd83efbc91efbc92efbc93' using utf8mb4),'ik') as case_03;
select tokenize(convert(X'e4b8ade59bbde4b8ade69687e695b0e68daee5ba93e585a8e69687e6a380e7b4a2' using utf8mb4),'ik') as case_04;
select tokenize(convert(X'e381b2e38289e3818ce381aa20e382abe382bfe382abe3838a20ed959ceab88020e6bca2e5ad97' using utf8mb4),'ik') as case_05;
select tokenize(convert(X'f09f9880f09f9a80f0a08080f0a0aeb7' using utf8mb4),'ik') as case_06;
select tokenize(convert(X'615f6220612d62206140622061236220312c32333420332e3134' using utf8mb4),'ik') as case_07;
select tokenize(convert(X'090a0d202c2e213fefbc8ce38082efbc81efbc9fefbc88efbc89e38090e38091' using utf8mb4),'ik') as case_08;
select tokenize(convert(X'41e4b8ade59bbd42efbc91efbc9263f09f988033e4b8ade69687' using utf8mb4),'ik') as case_09;
select tokenize(convert(X'e4b880e4ba8ce4b889e59b9be4ba94e585ade4b883e585abe4b99de58d81e799bee58d83e4b887e4babf20e4b8a4e58d81e4ba8ce58886e4b98be4b88920332e3134e585ace696a4' using utf8mb4),'ik') as case_10;
select tokenize(convert(X'68656c6c6f00776f726c6420e4b8ade59bbd00e585a8e69687' using utf8mb4),'ik') as case_11;
--enable_query_log
