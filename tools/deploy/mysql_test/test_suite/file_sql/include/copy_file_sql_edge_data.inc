# Extra fixtures are separate from data/ so the public glob fixture stays fixed.
--source mysql_test/test_suite/file_sql/include/copy_file_sql_data.inc
--disable_query_log
let $FILE_SQL_EDGE_DIR = $FILE_SQL_DATA_DIR/edge;
let $FILE_SQL_EDGE_COPY_CMD = ssh $FILE_SQL_HOST 'mkdir -p "$FILE_SQL_EDGE_DIR"' && scp -q $PWD/mysql_test/test_suite/file_sql/data_edge/* $FILE_SQL_HOST:"$FILE_SQL_EDGE_DIR/" && ssh $FILE_SQL_HOST 'base64 -d "$FILE_SQL_EDGE_DIR/1.0-NONE-False.parquet.b64" > "$FILE_SQL_EDGE_DIR/1.0-NONE-False.parquet" && base64 -d "$FILE_SQL_EDGE_DIR/1.0-NONE-True.parquet.b64" > "$FILE_SQL_EDGE_DIR/1.0-NONE-True.parquet" && base64 -d "$FILE_SQL_EDGE_DIR/1.0-SNAPPY-False.parquet.b64" > "$FILE_SQL_EDGE_DIR/1.0-SNAPPY-False.parquet" && base64 -d "$FILE_SQL_EDGE_DIR/1.0-SNAPPY-True.parquet.b64" > "$FILE_SQL_EDGE_DIR/1.0-SNAPPY-True.parquet" && base64 -d "$FILE_SQL_EDGE_DIR/2.0-NONE-False.parquet.b64" > "$FILE_SQL_EDGE_DIR/2.0-NONE-False.parquet" && base64 -d "$FILE_SQL_EDGE_DIR/2.0-NONE-True.parquet.b64" > "$FILE_SQL_EDGE_DIR/2.0-NONE-True.parquet" && base64 -d "$FILE_SQL_EDGE_DIR/2.0-SNAPPY-False.parquet.b64" > "$FILE_SQL_EDGE_DIR/2.0-SNAPPY-False.parquet" && base64 -d "$FILE_SQL_EDGE_DIR/2.0-SNAPPY-True.parquet.b64" > "$FILE_SQL_EDGE_DIR/2.0-SNAPPY-True.parquet" && base64 -d "$FILE_SQL_EDGE_DIR/array.jsonl.b64" > "$FILE_SQL_EDGE_DIR/array.jsonl" && base64 -d "$FILE_SQL_EDGE_DIR/bad.csv.b64" > "$FILE_SQL_EDGE_DIR/bad.csv" && base64 -d "$FILE_SQL_EDGE_DIR/nested.jsonl.b64" > "$FILE_SQL_EDGE_DIR/nested.jsonl" && base64 -d "$FILE_SQL_EDGE_DIR/types.csv.b64" > "$FILE_SQL_EDGE_DIR/types.csv" && base64 -d "$FILE_SQL_EDGE_DIR/utf8.csv.b64" > "$FILE_SQL_EDGE_DIR/utf8.csv" && ln -s /etc/passwd "$FILE_SQL_EDGE_DIR/escape.csv"';
exec $FILE_SQL_EDGE_COPY_CMD;
